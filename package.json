{
  "name": "packforge",
  "productName": "PackForge",
  "version": "0.3.0",
  "description": "Minecraft Java Edition resource pack studio with LabPBR preview",
  "private": true,
  "type": "module",
  "author": "Andrea",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Andrix03/packforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrix03/packforge.git"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs",
    "drive": "node scripts/drive/drive.mjs",
    "drive:all": "node scripts/drive/all.mjs",
    "dist": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "icon": "node scripts/make-icon.mjs",
    "dist:zip": "npm run build && electron-builder --win zip --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "drive:clean": "node scripts/drive/clean.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron": true
  }
}

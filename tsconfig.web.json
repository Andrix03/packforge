{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.web.tsbuildinfo"
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/*.d.ts"],
  "exclude": ["src/shared/**/*.test.ts"]
}

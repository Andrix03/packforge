<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the NSIS installer made from the signed app
     (PackForge-Setup-<version>.exe), uploaded by the Release workflow as a GitHub artifact. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="PackForge-Setup-*.exe" min-matches="1" max-matches="1" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>

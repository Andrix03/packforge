<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the unpacked Windows app uploaded by the Release
     workflow (a GitHub artifact, so a zip). Signs PackForge.exe before the installer is made. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PackForge.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
